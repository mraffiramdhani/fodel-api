    "description": "Public and authentication endpoints for Fodel Rust API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Home",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v{{apiVersion}}/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v{{apiVersion}}", ""]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"username\": \"john_doe\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v{{apiVersion}}", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const json = pm.response.json();",
                  "  const token = json?.data?.token;",
                  "  if (token) {",
                  "    pm.environment.set('token', token);",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v{{apiVersion}}", "login"]
            }
          }
        },
        {
          "name": "Token Check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/token/check",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v{{apiVersion}}", "token", "check"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v{{apiVersion}}", "password"]
            }
          }
        },
        {
          "name": "Register Restaurant",
